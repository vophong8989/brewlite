# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Ensure shell scripts, Dockerfiles, CI workflows, and PlantUML sources always use LF
*.sh text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.puml text eol=lf

# Diagrams and binary image assets
*.svg text
*.png binary
*.jpg binary