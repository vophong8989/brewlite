# ==========================================
# BrewLite - Environment Variables Example
# Copy file này thành .env ở local (KHÔNG commit .env)
# ==========================================

# --- Backend (NestJS + Prisma) ---
PORT=3001
NODE_ENV=development

# PostgreSQL connection string (local / CI)
DATABASE_URL="postgresql://brewlite:brewlite_pass@localhost:5432/brewlite_db?schema=public"

# JWT Authentication
JWT_SECRET="change_me_to_a_strong_random_secret_in_production"
JWT_EXPIRES_IN="1d"

# Payment Simulation (chỉ bật true ở dev/test/demo)
PAYMENT_ALLOW_SIMULATE=true

# Seed default accounts (bắt buộc đổi khi chạy seed, không hardcode trong code)
SEED_STAFF_EMAIL="staff@brewlite.local"
SEED_STAFF_PASSWORD="ChangeMeStaff123"
SEED_MANAGER_EMAIL="manager@brewlite.local"
SEED_MANAGER_PASSWORD="ChangeMeManager123"

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL="http://localhost:3001"