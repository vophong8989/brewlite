# ==========================================
# BrewLite - Environment Variables Example
# Copy file này thành .env ở local (KHÔNG commit .env)
# ==========================================

# --- Backend (NestJS + Prisma) ---
# Cổng chạy dịch vụ API NestJS
PORT=3001
# Môi trường chạy ứng dụng (development | test | production)
NODE_ENV=development
# Chuỗi kết nối cơ sở dữ liệu PostgreSQL (local hoặc CI)
DATABASE_URL="postgresql://brewlite:change-me@localhost:5432/brewlite_db?schema=public"
# Khóa bí mật ký và xác thực JWT
JWT_SECRET="change-me"
# Thời gian sống của access token JWT
JWT_EXPIRES_IN="1h"
# Danh sách origin được phép gọi API qua CORS
CORS_ORIGIN="http://localhost:3000"
# Cho phép giả lập kết quả thanh toán (chỉ bật true ở dev/test/demo)
PAYMENT_ALLOW_SIMULATE=true

# --- Seed Default Accounts ---
# Email tài khoản nhân viên quầy (STAFF) dùng khi chạy seed
SEED_STAFF_EMAIL="staff@brewlite.local"
# Mật khẩu tài khoản nhân viên quầy dùng khi chạy seed
SEED_STAFF_PASSWORD="change-me"
# Email tài khoản quản lý (MANAGER) dùng khi chạy seed
SEED_MANAGER_EMAIL="manager@brewlite.local"
# Mật khẩu tài khoản quản lý dùng khi chạy seed
SEED_MANAGER_PASSWORD="change-me"

# --- Frontend (Next.js) ---
# Địa chỉ gốc của Backend API
NEXT_PUBLIC_API_URL="http://localhost:3001"
# Hiển thị tùy chọn mô phỏng thanh toán thành công/thất bại trên giao diện
NEXT_PUBLIC_ALLOW_SIMULATE=true